# Copy this file to .env.local and fill in your Stripe TEST secret key.
# Find it at https://dashboard.stripe.com/test/apikeys (starts with sk_test_).
# Never commit the real key or use a live (sk_live_) key here.
STRIPE_SECRET_KEY=sk_test_...

# From your Stripe webhook endpoint (Developers -> Webhooks), after you add
# an endpoint pointing at https://<your-domain>/api/stripe/webhook.
# Starts with whsec_. Required for orders to be marked "paid" in the admin backend.
STRIPE_WEBHOOK_SECRET=whsec_...

# From your Supabase project (Settings -> API). Used server-side only to
# store orders, customers, and uploaded pet photos. Never expose the
# service role key to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Password for logging into /admin. Choose your own value — never commit the
# real one.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=...
